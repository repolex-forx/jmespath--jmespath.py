<https://repolex.ai/data/jmespath/jmespath.py/blob/8229bdef4e62b9859e72883575405e76a018f98b#test_bad_unicode_string> <https://repolex.ai/ontology/extracts/tree-sitter/tree-sitter/v0.25/core/text> "def test_bad_unicode_string(self):\n        # This error message is straight from the JSON parser\n        # and pypy has a slightly different error message,\n        # so we're not using assert_error_message.\n        error_message = re.compile(\n            r'Bad jmespath expression: '\n            r'Invalid \\\\uXXXX escape.*\\\\uAZ12', re.DOTALL)\n        with self.assertRaisesRegex(exceptions.LexerError, error_message):\n            self.parser.parse(r'\"\\uAZ12\"')" <https://repolex.ai/data/jmespath/jmespath.py/blob/8229bdef4e62b9859e72883575405e76a018f98b> .
