<https://repolex.ai/data/jmespath/jmespath.py/blob/8229bdef4e62b9859e72883575405e76a018f98b#TestParsedResultAddsOptions> <https://repolex.ai/ontology/extracts/tree-sitter/tree-sitter/v0.25/core/text> "class TestParsedResultAddsOptions(unittest.TestCase):\n    def test_can_have_ordered_dict(self):\n        p = parser.Parser()\n        parsed = p.parse('{a: a, b: b, c: c}')\n        options = visitor.Options(dict_cls=OrderedDict)\n        result = parsed.search(\n            {\"c\": \"c\", \"b\": \"b\", \"a\": \"a\"}, options=options)\n        # The order should be 'a', 'b' because we're using an\n        # OrderedDict\n        self.assertEqual(list(result), ['a', 'b', 'c'])" <https://repolex.ai/data/jmespath/jmespath.py/blob/8229bdef4e62b9859e72883575405e76a018f98b> .
