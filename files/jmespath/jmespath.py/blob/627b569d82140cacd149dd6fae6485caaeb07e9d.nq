<https://repolex.ai/data/jmespath/jmespath.py/blob/627b569d82140cacd149dd6fae6485caaeb07e9d#_get_allowed_pytypes> <https://repolex.ai/ontology/extracts/tree-sitter/tree-sitter/v0.25/core/text> "def _get_allowed_pytypes(self, types):\n        allowed_types = []\n        allowed_subtypes = []\n        for t in types:\n            type_ = t.split('-', 1)\n            if len(type_) == 2:\n                type_, subtype = type_\n                allowed_subtypes.append(REVERSE_TYPES_MAP[subtype])\n            else:\n                type_ = type_[0]\n            allowed_types.extend(REVERSE_TYPES_MAP[type_])\n        return allowed_types, allowed_subtypes" <https://repolex.ai/data/jmespath/jmespath.py/blob/627b569d82140cacd149dd6fae6485caaeb07e9d> .
